<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    本 POM 【不继承 framework-parent】—— 与 framework-auth-email-starter/framework-cache-redis-starter
    同一个理由：插件独立成仓后，它对框架的关系与业务方完全相同，通过 import framework-bom 拿版本仲裁，
    而不是靠继承拿到一整套构建配置。用同一套姿势消费框架，业务方会遇到的问题就会先在这里暴露。

    代价是下面这些构建配置要自带一份：
      - release=17                产物必须能跑在 Java 17 上（构建用哪个 JDK 不作要求）
      - enforcer 的 requireJavaVersion  唯一的构建前提：JDK >= 17
      - surefire 的 UTF-8         中文 Windows 上默认 GBK，断言里的中文会对不上（CLAUDE.md 3.6）
      - enforcer 的两条 ban       JDBC 驱动、Jackson 3
    唯独【不带】framework 仓里的 enforce-core-thin —— 本插件的职责就是可选地引入 Bouncy Castle（SM4）。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-crypto-starter</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>describeadmin :: framework-crypto-starter</name>
  <description>敏感字段加密入库插件：MyBatis-Plus 透明加解密（AES-256-GCM / SM4-GCM）+ 盲索引 + 手动加解密门面</description>
  <url>https://github.com/describeadmin/framework-crypto-starter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework-crypto-starter.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework-crypto-starter.git</developerConnection>
    <url>https://github.com/describeadmin/framework-crypto-starter</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 不对构建 JDK 做版本要求，唯一前提是 JDK >= 17（enforcer 的 requireJavaVersion 兜底）。 -->
    <maven.compiler.release>17</maven.compiler.release>
    <enforcer.java.version>[17,)</enforcer.java.version>

    <!--
      ⚠️ 本插件构建所针对的框架版本，必须与
      FrameworkCryptoAutoConfiguration.REQUIRED_FRAMEWORK_VERSION 对得上——
      那个常量是运行期自检读的，这个属性是构建期解析用的，两者说的是同一件事。
      插件自身版本号（上面的 <version>）与它【不联动】。
    -->
    <describeadmin.version>1.0.0</describeadmin.version>

    <!--
      SM4-GCM/HmacSM3 需要 Bouncy Castle 提供 JCE Provider（标准 OpenJDK 不自带 SM4）。
      版本已核实 https://repo1.maven.org/maven2/org/bouncycastle/bcprov-jdk18on/maven-metadata.xml
      的 <release> 真实存在。命名是 jdk18on（面向 JDK 1.8+），不要写成旧资料常见的 jdk15on。
    -->
    <bouncycastle.version>1.85.2</bouncycastle.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        业务方的姿势：只 import framework-bom，不写任何框架模块的版本号。
        Spring Boot 的版本仲裁由它传递过来，本插件不再自己 import spring-boot-dependencies。
      -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${describeadmin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      compile：本插件的主要交付物是"给 MyBatis-Plus 实体做透明加解密"，
      InnerInterceptor 扩展点、BaseEntity/TypeHandler 生态都来自这里。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-mybatis-starter</artifactId>
    </dependency>

    <!-- FrameworkVersion 启动期自检来自这里，framework-mybatis-starter 已传递依赖，这里显式声明便于阅读。 -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-common</artifactId>
    </dependency>

    <!--
      optional：只有 SM4-GCM/HmacSM3 才需要，只用 AES 的业务方不应被迫引入 BC。
      Sm4CryptoProvider 的自动配置用 @ConditionalOnClass(name = "org.bouncycastle...") 判断，
      不用就完全不在 classpath 上，等同没引这个能力。
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      同仓时期由 framework-parent 的 <dependencies> 提供，独立成仓后必须自己声明——
      这类"继承来的隐式依赖"是拆仓最容易漏的东西。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      SM4 单测里要用 BC 原生 API 独立交叉验证密文语义，不能只用自己的 decryptRaw 自证自己——
      不需要再声明一次 test scope：optional=true 只影响"是否传递给本模块的消费方"，
      本模块自己的 main/test 编译都能看到这个依赖，重复声明反而会触发
      "duplicate declaration" 警告并让后声明的 scope 覆盖前者，把 optional 编译依赖顶掉。
    -->

    <!-- MySQL Testcontainers 集成测试：验证 TypeHandler/InnerInterceptor 在真实 JDBC 往返里确实生效。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      ⚠️ CLAUDE.md §3.4 禁止框架/插件依赖 JDBC 驱动，但本插件的 MySQL 集成测试必须有驱动才能跑，
      且只在 test 作用域，绝不会传给消费者（业务方自己的 pom.xml 才声明真正生产用的驱动）。
      下面 enforcer 的 bannedDependencies 已用 <scope> 限定排除，只放行 test 作用域。
    -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- 测试 JVM 必须显式指定 UTF-8，理由同 CLAUDE.md 3.6 -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>${enforcer.java.version}</version>
                  <message>
                    构建本插件需要 JDK 17 或更高版本（用 `mvn -v` 查看 Maven 实际使用的 JDK）。
                  </message>
                </requireJavaVersion>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <!-- test 作用域放行：MySQL 集成测试需要真实驱动，且绝不会传给业务方（见上方依赖声明处的注释）。 -->
                    <exclude>com.mysql:mysql-connector-j:*:*:compile</exclude>
                    <exclude>com.mysql:mysql-connector-j:*:*:runtime</exclude>
                    <exclude>com.mysql:mysql-connector-j:*:*:provided</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架与插件均不得在 compile/runtime/provided 作用域依赖 JDBC 驱动。
                    驱动由业务方在自己的 pom.xml 中声明；本插件的 mysql-connector-j 仅用于
                    test 作用域的集成测试，不会传递给消费方。
                  </message>
                </bannedDependencies>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。
                    tools.jackson.* 是 Jackson 3，属于 Spring Boot 4.x 生态。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 发布 profile，与 framework-auth-email-starter/framework-cache-redis-starter 保持一致。步骤参照 docs 仓的 RELEASE.md。 -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
